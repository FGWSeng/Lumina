{
  "name": "lumina",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "可扩展多科目题库网站 · Cloudflare Pages",
  "scripts": {
    "dev": "vite",
    "import": "node scripts/import-html.mjs",
    "build:data": "node scripts/build-data.mjs",
    "build": "npm run build:data && vite build",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler pages deploy dist --project-name=lumina --branch=main",
    "check": "node scripts/check-data.mjs"
  },
  "dependencies": {
    "katex": "^0.19.1",
    "lucide-react": "^1.70.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@vitejs/plugin-react": "^6.2.1",
    "tailwindcss": "^4.3.5",
    "vite": "^8.3.6"
  }
}
